0 ICON "..\\resources\\bitmaps\\opencpn.ico"
1 VERSIONINFO
    FILEVERSION ${VERSION_MAJOR},${VERSION_MINOR},${VERSION_PATCH},0
    PRODUCTVERSION ${VERSION_MAJOR},${VERSION_MINOR}, 0, 0
    FILEFLAGSMASK 0
    FILEOS 0x00040004L
    FILETYPE 0x00000001L
    BEGIN
        BLOCK "StringFileInfo"
            BEGIN
                BLOCK "040904E4"
                    BEGIN
                        VALUE "CompanyName",      "ITS\0"
                        VALUE "FileDescription",  "ITS\0"
                        VALUE "FileVersion",      "${VERSION_MAJOR},${VERSION_MINOR},${VERSION_PATCH}\0"
                        VALUE "InternalName",     "ITS.exe\0"
                        VALUE "LegalCopyright",   "GPL v2\0"
                        VALUE "OriginalFilename", "ITS.exe\0"
                        VALUE "ProductName",      "ITS\0"
                        VALUE "ProductVersion",   "${VERSION_MAJOR},${VERSION_MINOR}\0"
                    END
            END

        BLOCK "VarFileInfo"
            BEGIN

            END
    END
