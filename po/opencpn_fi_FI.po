msgid ""
"\n"
"    Install/uninstall plugin or remove file to mute message"
msgstr ""
"\n"
"    Estä viesti asentamalla tai poistamalla lisäosa tai poistamalla tiedosto."
#
msgid ""
"\n"
" - your GPS offset from bow must be within your ship's length"
msgstr ""
"\n"
" - GPS etäisyys keulasta on oltava aluksen pituuden aluella"
#
msgid ""
"\n"
" - your GPS offset from midship must be within your ship's beam"
msgstr ""
"\n"
" - GPS poikkeama keskilaivasta on oltava aluksen leveyden sisäpuolella"
#
msgid ""
"\n"
" - your minimum ship icon size must be between 1 and 100 mm"
msgstr ""
"\n"
" - aluksen kuvakkeen minimikoon tulee olla välillä 1-100 mm"
